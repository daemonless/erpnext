# ERPNext for FreeBSD (Daemonless)
# Copy to .env and edit.

# Where data lives on the host
SITES_LOCATION=/containers/erpnext/sites
DB_DATA_LOCATION=/containers/erpnext/mariadb
REDIS_DATA_LOCATION=/containers/erpnext/redis

# The site to create and serve; any hostname reaches it.
SITE_NAME=erpnext.localhost

# Set both before the first start: the Administrator login, and the MariaDB
# root password (the site is created with it).
ADMIN_PASSWORD=
DB_ROOT_PASSWORD=

# Timezone (TZ identifier)
# TZ=UTC
